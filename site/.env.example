# Copy to .env.local and fill in. Both are required before the admin portal
# will let anyone in — there is no default password.

# The admin password. Anything you would be happy to see in a password manager.
MUNINN_ADMIN_PASSWORD=

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MUNINN_SESSION_SECRET=

# Where the SQLite file lives. Defaults to ./data/muninn-site.db
# MUNINN_DB_PATH=/var/lib/muninn-site/analytics.db

# Where the download button actually sends people.
MUNINN_DOWNLOAD_URL=https://github.com/your-org/muninn/releases/latest
