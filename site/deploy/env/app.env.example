# Copy to /opt/muninn-site/shared/env/app.env and fill in. chmod 640.
#
# ⚠ Compose interpolates env_file values on this box: any `$` in a value must
#   be doubled (`$$`). Simplest to avoid `$` entirely — none of these need one.

# The admin portal password. There is no default and no account list; this is
# the whole auth surface, so make it long.
MUNINN_ADMIN_PASSWORD=

# Signs the admin session cookie. The app refuses to start signing sessions
# with anything under 16 characters. Generate with:
#   openssl rand -hex 32
MUNINN_SESSION_SECRET=

# Where the download button sends people. Recorded, then redirected.
MUNINN_DOWNLOAD_URL=https://github.com/your-org/muninn/releases/latest

# Inside the container. Maps to ${MN_DATA_DIR} on the host via compose.
MUNINN_DB_PATH=/data/muninn-site.db
