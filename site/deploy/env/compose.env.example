# Copy to /opt/muninn-site/shared/env/compose.env. chmod 640.
# These configure the compose file itself, not the app.

# The single loopback port host nginx proxies to. Check it is free first:
#   ss -ltnp | sort -t: -k2 -n | grep 127.0.0.1
MN_PORT=3520

# Host paths.
MN_ENV_FILE=/opt/muninn-site/shared/env/app.env
MN_DATA_DIR=/opt/muninn-site/shared/data
