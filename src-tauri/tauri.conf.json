{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muninn",
  "version": "0.1.0",
  "identifier": "dev.muninn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && bash tools/build-shim.sh"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Muninn",
        "url": "index.html",
        "width": 516,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": true
      },
      {
        "label": "details",
        "title": "Muninn \u2014 details",
        "url": "details.html",
        "width": 900,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true
      },
      {
        "label": "waiting",
        "title": "Muninn",
        "url": "waiting.html",
        "width": 1456,
        "height": 784,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      },
      {
        "label": "history",
        "title": "Muninn \u2014 history",
        "url": "history.html",
        "width": 900,
        "height": 700,
        "minWidth": 520,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true
      },
      {
        "label": "notice",
        "title": "Muninn",
        "url": "notice.html",
        "width": 516,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/muninn-forward"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
